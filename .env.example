# H3C 网络设备 SSH 登录凭据
# 复制本文件为 .env 并填写真实值（.env 已被 gitignore，不会入库）

# 全局默认账号（所有交换机共用；若某设备单独配置，则以设备配置为准）
NETWORK_SSH_USERNAME=admin
NETWORK_SSH_PASSWORD=

# 按设备独立凭据（可选，JSON 对象，键为设备管理 IP；优先级高于全局默认）
# 例：NETWORK_SSH_DEVICES={"192.168.10.1":{"username":"admin","password":"pwd1"},"192.168.10.2":{"username":"admin","password":"pwd2"}}
NETWORK_SSH_DEVICES={}

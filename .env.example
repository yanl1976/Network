# H3C 网络设备 SSH 登录凭据
# 复制本文件为 .env 并填写真实值（.env 已被 gitignore，不会入库）

# 全局默认账号（所有交换机共用；若某设备单独配置，则以设备配置为准）
NETWORK_SSH_USERNAME=admin
NETWORK_SSH_PASSWORD=
# super 提权密码：部分 H3C 设备登录后需输入 super + 回车 + 密码才能执行命令
NETWORK_SSH_SUPER_PASSWORD=

# 按设备独立凭据（可选，JSON 对象，键为设备管理 IP；优先级高于全局默认，账号只读，不得修改配置）
# 字段：username / password / superPassword（superPassword 可选，仅需要提权的设备填）
# 例：NETWORK_SSH_DEVICES={"192.168.10.1":{"username":"admin","password":"pwd1","superPassword":"super1"},"192.168.10.2":{"username":"admin","password":"pwd2"}}
NETWORK_SSH_DEVICES={}

# 写操作令牌（可选；设置后所有 POST/PUT/DELETE 需在请求头带 X-API-Token）
# 未设置时接口对内网开放（保持兼容），生产环境建议设置随机字符串
NETWORK_WRITE_TOKEN=
